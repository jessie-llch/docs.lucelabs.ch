{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "Lucelabs Hilfe",
    "description": "Hilfe zu Lucelabs, dem Schweizer Assistenten für Unternehmens-Websites.",
    "colors": {
        "primary": "#c2410c",
        "light": "#ff7a33",
        "dark": "#1a1a1a"
    },
    "background": {
        "color": {
            "light": "#fafaf8",
            "dark": "#0e0e0e"
        }
    },
    "logo": {
        "light": "/logo/dark-on-light.png",
        "dark": "/logo/light-on-dark.png",
        "href": "https://docs.lucelabs.ch"
    },
    "fonts": {
        "heading": {
            "family": "Nohemi",
            "weight": 600,
            "source": "/fonts/Nohemi-SemiBold.woff2",
            "format": "woff2"
        },
        "body": {
            "family": "Nohemi",
            "weight": 400,
            "source": "/fonts/Nohemi-Regular.woff2",
            "format": "woff2"
        }
    },
    "favicon": "/favicon.svg",
    "appearance": {
        "default": "system"
    },
    "navbar": {
        "links": [
            {
                "label": "Kontakt",
                "href": "https://lucelabs.ch/contact/"
            },
            {
                "label": "Status",
                "href": "https://lucelabs.ch/status/"
            },
            {
                "label": "Entwickler-Login",
                "href": "https://lucelabs.ch/admin/docs/"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Zum Dashboard",
            "href": "https://lucelabs.ch/dashboard/"
        }
    },
    "navigation": {
        "tabs": [
            {
                "tab": "Anleitung",
                "groups": [
                    {
                        "group": "Los geht's",
                        "pages": [
                            "index",
                            "start/assistent-erstellen",
                            "start/dashboard",
                            "start/einbauen",
                            "start/ist-er-live",
                            "start/testen"
                        ]
                    },
                    {
                        "group": "Ihr Assistent",
                        "pages": [
                            "assistent/wissen",
                            "assistent/website-lesen",
                            "assistent/fragen-und-antworten",
                            "assistent/antworten",
                            "assistent/offene-fragen",
                            "assistent/sprachen",
                            "assistent/verwalten"
                        ]
                    },
                    {
                        "group": "Der Chat",
                        "pages": [
                            "assistent/aussehen",
                            "chat/begruessung",
                            "chat/fuer-besucher",
                            "chat/kontaktformular"
                        ]
                    },
                    {
                        "group": "Funktionen",
                        "pages": [
                            "funktionen/termine",
                            "funktionen/reservationen",
                            "funktionen/shop",
                            "funktionen/newsletter",
                            "funktionen/verbindungen"
                        ]
                    },
                    {
                        "group": "Im Alltag",
                        "pages": [
                            "alltag/gespraeche",
                            "alltag/live-chat",
                            "alltag/anfragen",
                            "alltag/statistik",
                            "alltag/benachrichtigungen"
                        ]
                    },
                    {
                        "group": "Hilfe",
                        "pages": [
                            "haeufige-fragen",
                            "hilfe/support",
                            "hilfe/ausprobieren"
                        ]
                    }
                ]
            },
            {
                "tab": "Integrationen",
                "groups": [
                    {
                        "group": "Integrationen",
                        "pages": [
                            "integrationen/index",
                            {
                                "group": "Website",
                                "pages": [
                                    "integrationen/wordpress",
                                    "integrationen/wix",
                                    "integrationen/squarespace",
                                    "integrationen/webflow",
                                    "integrationen/jimdo",
                                    "integrationen/typo3",
                                    "integrationen/joomla",
                                    "integrationen/framer",
                                    "integrationen/andere-websites"
                                ]
                            },
                            {
                                "group": "Kalender & Termine",
                                "pages": [
                                    "integrationen/outlook",
                                    "integrationen/google-kalender",
                                    "integrationen/calendly"
                                ]
                            },
                            {
                                "group": "Shop",
                                "pages": [
                                    "integrationen/woocommerce",
                                    "integrationen/shopify"
                                ]
                            },
                            {
                                "group": "Newsletter",
                                "pages": [
                                    "integrationen/brevo",
                                    "integrationen/mailchimp"
                                ]
                            },
                            {
                                "group": "Daten",
                                "pages": [
                                    "integrationen/oev",
                                    "integrationen/open-meteo"
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "tab": "Konto und Preise",
                "groups": [
                    {
                        "group": "Team und Konto",
                        "pages": [
                            "konto/team",
                            "konto/einstellungen",
                            "konto/anmeldung",
                            "konto/datenschutz"
                        ]
                    },
                    {
                        "group": "Abo und Preise",
                        "pages": [
                            "konto/plaene",
                            "konto/testphase",
                            "konto/abo-verwalten",
                            "konto/zusatzgespraeche",
                            "konto/zusatzoptionen"
                        ]
                    }
                ]
            }
        ]
    },
    "footer": {
        "socials": {
            "website": "https://lucelabs.ch"
        }
    }
}
