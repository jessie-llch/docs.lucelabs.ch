{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "Lucelabs Hilfe",
    "description": "Hilfe zu Lucelabs, dem Schweizer Assistenten für Unternehmens-Websites.",
    "colors": {
        "primary": "#c2410c",
        "light": "#ff7a33",
        "dark": "#1a1a1a"
    },
    "background": {
        "color": {
            "light": "#fafaf8",
            "dark": "#0e0e0e"
        }
    },
    "logo": {
        "light": "/logo/dark-on-light.png",
        "dark": "/logo/light-on-dark.png",
        "href": "https://docs.lucelabs.ch"
    },
    "fonts": {
        "heading": {
            "family": "Nohemi",
            "weight": 600,
            "source": "/fonts/Nohemi-SemiBold.woff2",
            "format": "woff2"
        },
        "body": {
            "family": "Nohemi",
            "weight": 400,
            "source": "/fonts/Nohemi-Regular.woff2",
            "format": "woff2"
        }
    },
    "favicon": "/favicon.svg",
    "appearance": {
        "default": "system"
    },
    "navbar": {
        "links": [
            {
                "label": "Kontakt",
                "href": "https://lucelabs.ch/contact/"
            },
            {
                "label": "Status",
                "href": "https://lucelabs.ch/status/"
            },
            {
                "label": "Entwickler-Login",
                "href": "https://lucelabs.ch/admin/docs/"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Zum Dashboard",
            "href": "https://lucelabs.ch/dashboard/"
        }
    },
    "navigation": {
        "tabs": [
            {
                "tab": "Anleitung",
                "icon": "book",
                "groups": [
                    {
                        "group": "Los geht's",
                        "icon": "rocket",
                        "pages": [
                            "index",
                            "start/assistent-erstellen",
                            "start/einbauen",
                            "start/ist-er-live",
                            "start/testen",
                            "start/dashboard"
                        ]
                    },
                    {
                        "group": "Ihr Assistent",
                        "icon": "sparkles",
                        "pages": [
                            {
                                "group": "Wissen und Antworten",
                                "icon": "book-open",
                                "expanded": false,
                                "pages": [
                                    "assistent/wissen",
                                    "assistent/website-lesen",
                                    "assistent/fragen-und-antworten",
                                    "assistent/antworten",
                                    "assistent/offene-fragen",
                                    "assistent/sprachen"
                                ]
                            },
                            {
                                "group": "Chat-Fenster",
                                "icon": "comment-dots",
                                "expanded": false,
                                "pages": [
                                    "assistent/aussehen",
                                    "chat/begruessung",
                                    "chat/fuer-besucher",
                                    "chat/kontaktformular"
                                ]
                            },
                            "assistent/verwalten"
                        ]
                    },
                    {
                        "group": "Funktionen",
                        "icon": "puzzle-piece",
                        "pages": [
                            "funktionen/termine",
                            "funktionen/reservationen",
                            "funktionen/shop",
                            "funktionen/newsletter",
                            "funktionen/verbindungen"
                        ]
                    },
                    {
                        "group": "Im Alltag",
                        "icon": "mug-hot",
                        "expanded": false,
                        "pages": [
                            "alltag/gespraeche",
                            "alltag/live-chat",
                            "alltag/anfragen",
                            "alltag/statistik",
                            "alltag/benachrichtigungen"
                        ]
                    },
                    {
                        "group": "Hilfe",
                        "icon": "life-ring",
                        "pages": [
                            "haeufige-fragen",
                            "hilfe/support",
                            "hilfe/ausprobieren"
                        ]
                    }
                ]
            },
            {
                "tab": "Integrationen",
                "icon": "plug",
                "groups": [
                    {
                        "group": "Übersicht",
                        "icon": "border-all",
                        "pages": [
                            "integrationen/index"
                        ]
                    },
                    {
                        "group": "Website",
                        "icon": "globe",
                        "expanded": false,
                        "pages": [
                            "integrationen/wordpress",
                            "integrationen/wix",
                            "integrationen/squarespace",
                            "integrationen/webflow",
                            "integrationen/jimdo",
                            "integrationen/typo3",
                            "integrationen/joomla",
                            "integrationen/framer",
                            "integrationen/andere-websites"
                        ]
                    },
                    {
                        "group": "Kalender & Termine",
                        "icon": "calendar",
                        "pages": [
                            "integrationen/lucelabs-kalender",
                            "integrationen/outlook",
                            "integrationen/google-kalender",
                            "integrationen/calendly"
                        ]
                    },
                    {
                        "group": "Shop",
                        "icon": "cart-shopping",
                        "pages": [
                            "integrationen/woocommerce",
                            "integrationen/shopify"
                        ]
                    },
                    {
                        "group": "Newsletter",
                        "icon": "envelope",
                        "pages": [
                            "integrationen/brevo",
                            "integrationen/mailchimp"
                        ]
                    },
                    {
                        "group": "Daten",
                        "icon": "database",
                        "pages": [
                            "integrationen/oev",
                            "integrationen/open-meteo"
                        ]
                    }
                ]
            },
            {
                "tab": "Konto und Preise",
                "icon": "user",
                "groups": [
                    {
                        "group": "Team und Konto",
                        "icon": "users",
                        "pages": [
                            "konto/team",
                            "konto/einstellungen",
                            "konto/anmeldung",
                            "konto/datenschutz"
                        ]
                    },
                    {
                        "group": "Abo und Preise",
                        "icon": "credit-card",
                        "pages": [
                            "konto/plaene",
                            "konto/testphase",
                            "konto/abo-verwalten",
                            "konto/zusatzgespraeche",
                            "konto/zusatzoptionen"
                        ]
                    }
                ]
            }
        ]
    },
    "footer": {
        "socials": {
            "website": "https://lucelabs.ch"
        }
    }
}
